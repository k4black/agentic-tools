# Codex execpolicy rules (Starlark) — symlinked to ~/.codex/rules/agentic-tools.rules
# by install.sh. Additive: codex loads every file in ~/.codex/rules/, so this never
# touches default.rules (where codex appends its own "always allow" amendments).
#
# Matching is on tokenized argv PREFIXES (a flag between tokens breaks the match),
# most restrictive rule wins (forbidden > prompt > allow). Validate with:
#   codex execpolicy check --pretty --rules permissions/codex.rules -- gh pr view 1
#
# Only read-only commands belong here. Codex's built-in safe list already covers
# plain ls/cat/grep/find/git-read-only — these rules add what it misses: read-only
# gh and tree. Deliberately absent: test runners (project-level decision) and
# `gh api` (can POST).

prefix_rule(
    pattern = ["tree"],
    decision = "allow",
    justification = "read-only directory tree",
)

prefix_rule(
    pattern = ["gh", "pr", ["view", "list", "diff", "checks"]],
    decision = "allow",
    justification = "read-only GitHub PR inspection",
    match = [["gh", "pr", "view"], "gh pr diff 12", "gh pr checks 7 --required"],
    not_match = ["gh pr create", "gh pr merge 12"],
)

prefix_rule(
    pattern = ["gh", "repo", "view"],
    decision = "allow",
    justification = "read-only repo metadata",
)

prefix_rule(
    pattern = ["gh", "run", ["view", "list"]],
    decision = "allow",
    justification = "read-only CI run inspection",
)
